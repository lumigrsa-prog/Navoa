// Teste de Mutação de Vetores em Vortex
seja numeros = [10, 20, 30];

imprimir "Valor original no índice 0:";
imprimir numeros[0];

// Mutação: alterar o primeiro elemento para 99
numeros[0] = 99;

imprimir "Novo valor no índice 0 após a atribuição:";
imprimir numeros[0];

imprimir "Vetor completo atualizado:";
imprimir numeros;
