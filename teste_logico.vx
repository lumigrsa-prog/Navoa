// Teste de Booleanos e Operadores Lógicos

seja ativo = verdadeiro;
seja pontuacao = 85;

imprimir "Estado ativo:";
imprimir ativo;

se ativo e pontuacao > 80 {
    imprimir "Condição E atendida com sucesso!";
} senao {
    imprimir "Condição não atendida.";
}

se falso ou pontuacao == 85 {
    imprimir "Condição OU atendida com sucesso!";
}
