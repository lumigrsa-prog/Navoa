{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Navoa Studio",
  "version": "0.1.0",
  "identifier": "com.navoa.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Navoa Studio IDE",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
