use navoa_lexer::Token;
use navoa_vir::{VirStatement, VirExpr, VirOp};

pub struct Parser {
    tokens: Vec<(Token, usize, usize)>,
    position: usize,
}

impl Parser {
    pub fn new(tokens: Vec<(Token, usize, usize)>) -> Self {
        Self { tokens, position: 0 }
    }

    pub fn parse(&mut self) -> Result<Vec<VirStatement>, String> {
        let mut statements = Vec::new();
        while !self.is_at_end() {
            statements.push(self.parse_statement()?);
        }
        Ok(statements)
    }

    fn parse_statement(&mut self) -> Result<VirStatement, String> {
        match self.peek() {
            Token::Se => self.parse_if_statement(),
            Token::Enquanto => self.parse_while_statement(),
            Token::Funcao => self.parse_function_decl(),
            Token::Retorna => self.parse_return_statement(),
            Token::Seja => self.parse_var_decl(),
            Token::Ident(ref name) if name == "print" => self.parse_print(),
            Token::Ident(_) => self.parse_assign_or_expr(),
            _ => {
                let expr = self.parse_expression()?;
                if self.check(&Token::Semicolon) {
                    self.advance();
                }
                Ok(VirStatement::Expr(expr))
            }
        }
    }

    fn parse_block(&mut self) -> Result<Vec<VirStatement>, String> {
        self.consume(&Token::LBrace, "Esperado '{' a abrir o bloco.")?;
        let mut statements = Vec::new();
        while !self.check(&Token::RBrace) && !self.is_at_end() {
            statements.push(self.parse_statement()?);
        }
        self.consume(&Token::RBrace, "Esperado '}' a fechar o bloco.")?;
        Ok(statements)
    }

    fn parse_if_statement(&mut self) -> Result<VirStatement, String> {
        self.advance(); // consome 'se'
        self.consume(&Token::LParen, "Esperado '(' após 'se'.")?;
        let condition = self.parse_expression()?;
        self.consume(&Token::RParen, "Esperado ')' após a condição do 'se'.")?;

        let then_branch = self.parse_block()?;

        let else_branch = if self.match_token(&[Token::Senao]) {
            Some(self.parse_block()?)
        } else {
            None
        };

        Ok(VirStatement::If {
            condition,
            then_branch,
            else_branch,
        })
    }

    fn parse_while_statement(&mut self) -> Result<VirStatement, String> {
        self.advance(); // consome 'enquanto'
        let condition = self.parse_expression()?;
        let body = self.parse_block()?;

        Ok(VirStatement::While { condition, body })
    }

    fn parse_function_decl(&mut self) -> Result<VirStatement, String> {
        self.advance(); // consome 'funcao'
        let (line, col) = (self.peek_line(), self.peek_col());
        let name = match self.advance() {
            Token::Ident(n) => n,
            other => return Err(format!("[Linha {}, Coluna {}] Esperado identificador de função, encontrado {:?}", line, col, other)),
        };
        self.consume(&Token::LParen, "Esperado '(' após o nome da função.")?;

        let mut params = Vec::new();
        if !self.check(&Token::RParen) {
            loop {
                let (p_line, p_col) = (self.peek_line(), self.peek_col());
                match self.advance() {
                    Token::Ident(param) => params.push(param),
                    other => return Err(format!("[Linha {}, Coluna {}] Esperado nome de parâmetro, encontrado {:?}", p_line, p_col, other)),
                }
                if !self.match_token(&[Token::Comma]) {
                    break;
                }
            }
        }
        self.consume(&Token::RParen, "Esperado ')' após os parâmetros da função.")?;

        let body = self.parse_block()?;

        Ok(VirStatement::FunctionDecl { name, params, body })
    }

    fn parse_return_statement(&mut self) -> Result<VirStatement, String> {
        self.advance(); // consome 'retorna'
        let value = if self.check(&Token::Semicolon) {
            None
        } else {
            Some(self.parse_expression()?)
        };
        if self.check(&Token::Semicolon) {
            self.advance();
        }
        Ok(VirStatement::Return(value))
    }

    fn parse_var_decl(&mut self) -> Result<VirStatement, String> {
        self.advance(); // seja
        let (line, col) = (self.peek_line(), self.peek_col());
        let name = match self.advance() {
            Token::Ident(n) => n,
            other => return Err(format!("[Linha {}, Coluna {}] Esperado identificador após 'seja', encontrado {:?}", line, col, other)),
        };
        self.consume(&Token::Assign, "Esperado '=' após identificador em declaração.")?;
        let initializer = self.parse_expression()?;
        if self.check(&Token::Semicolon) {
            self.advance();
        }
        Ok(VirStatement::VarDecl { name, initializer })
    }

    fn parse_print(&mut self) -> Result<VirStatement, String> {
        self.advance(); // print
        self.consume(&Token::LParen, "Esperado '(' após 'print'.")?;
        let expr = self.parse_expression()?;
        self.consume(&Token::RParen, "Esperado ')' após expressão do 'print'.")?;
        if self.check(&Token::Semicolon) {
            self.advance();
        }
        Ok(VirStatement::Print(expr))
    }

    fn parse_assign_or_expr(&mut self) -> Result<VirStatement, String> {
        let name = match self.peek() {
            Token::Ident(n) => n.clone(),
            _ => unreachable!(),
        };
        self.advance();

        if self.match_token(&[Token::Assign]) {
            let value = self.parse_expression()?;
            if self.check(&Token::Semicolon) {
                self.advance();
            }
            Ok(VirStatement::Assign { name, value })
        } else {
            self.position -= 1;
            let expr = self.parse_expression()?;
            if self.check(&Token::Semicolon) {
                self.advance();
            }
            Ok(VirStatement::Expr(expr))
        }
    }

    fn parse_expression(&mut self) -> Result<VirExpr, String> {
        self.parse_equality()
    }

    fn parse_equality(&mut self) -> Result<VirExpr, String> {
        let mut expr = self.parse_comparison()?;

        while self.match_token(&[Token::Equal, Token::NotEqual]) {
            let token = self.previous().clone();
            let right = self.parse_comparison()?;
            let op = match token {
                Token::Equal => VirOp::Equal,
                Token::NotEqual => VirOp::NotEqual,
                _ => unreachable!(),
            };
            expr = VirExpr::Binary {
                left: Box::new(expr),
                op,
                right: Box::new(right),
            };
        }
        Ok(expr)
    }

    fn parse_comparison(&mut self) -> Result<VirExpr, String> {
        let mut expr = self.parse_term()?;

        while self.match_token(&[Token::LessThan, Token::GreaterThan]) {
            let token = self.previous().clone();
            let right = self.parse_term()?;
            let op = match token {
                Token::LessThan => VirOp::LessThan,
                Token::GreaterThan => VirOp::GreaterThan,
                _ => unreachable!(),
            };
            expr = VirExpr::Binary {
                left: Box::new(expr),
                op,
                right: Box::new(right),
            };
        }
        Ok(expr)
    }

    fn parse_term(&mut self) -> Result<VirExpr, String> {
        let mut expr = self.parse_factor()?;

        while self.match_token(&[Token::Plus, Token::Minus]) {
            let token = self.previous().clone();
            let right = self.parse_factor()?;
            let op = match token {
                Token::Plus => VirOp::Add,
                Token::Minus => VirOp::Sub,
                _ => unreachable!(),
            };
            expr = VirExpr::Binary {
                left: Box::new(expr),
                op,
                right: Box::new(right),
            };
        }
        Ok(expr)
    }

    fn parse_factor(&mut self) -> Result<VirExpr, String> {
        let mut expr = self.parse_unary()?;

        while self.match_token(&[Token::Star, Token::Slash]) {
            let token = self.previous().clone();
            let right = self.parse_unary()?;
            let op = match token {
                Token::Star => VirOp::Mul,
                Token::Slash => VirOp::Div,
                _ => unreachable!(),
            };
            expr = VirExpr::Binary {
                left: Box::new(expr),
                op,
                right: Box::new(right),
            };
        }
        Ok(expr)
    }

    fn parse_unary(&mut self) -> Result<VirExpr, String> {
        self.parse_primary()
    }

    fn parse_primary(&mut self) -> Result<VirExpr, String> {
        let (line, col) = (self.peek_line(), self.peek_col());
        let mut expr = match self.advance() {
            Token::Int(val) => VirExpr::Int(val),
            Token::Float(val) => VirExpr::Float(val),
            Token::String(val) => VirExpr::String(val),
            Token::Bool(val) => VirExpr::Bool(val),
            Token::Ident(name) => {
                if self.match_token(&[Token::LParen]) {
                    let mut args = Vec::new();
                    if !self.check(&Token::RParen) {
                        loop {
                            args.push(self.parse_expression()?);
                            if !self.match_token(&[Token::Comma]) {
                                break;
                            }
                        }
                    }
                    self.consume(&Token::RParen, "Esperado ')' após os argumentos da chamada.")?;
                    VirExpr::Call { name, args }
                } else {
                    VirExpr::Var(name)
                }
            }
            Token::LParen => {
                let expr = self.parse_expression()?;
                self.consume(&Token::RParen, "Esperado ')' após expressão.")?;
                expr
            }
            Token::LBrack => {
                let mut elements = Vec::new();
                if !self.check(&Token::RBrack) {
                    loop {
                        elements.push(self.parse_expression()?);
                        if !self.match_token(&[Token::Comma]) {
                            break;
                        }
                    }
                }
                self.consume(&Token::RBrack, "Esperado ']' após elementos da lista.")?;
                VirExpr::List(elements)
            }
            Token::LBrace => {
                let mut pairs = Vec::new();
                if !self.check(&Token::RBrace) {
                    loop {
                        let key_expr = self.parse_expression()?;
                        let key = if let VirExpr::String(s) = key_expr {
                            s
                        } else {
                            return Err("Esperada chave do tipo string no mapa.".to_string());
                        };
                        self.consume(&Token::Colon, "Esperado ':' após a chave do mapa.")?;
                        let val = self.parse_expression()?;
                        pairs.push((key, val));
                        if !self.match_token(&[Token::Comma]) {
                            break;
                        }
                    }
                }
                self.consume(&Token::RBrace, "Esperado '}' após elementos do mapa.")?;
                VirExpr::Map(pairs)
            }
            other => return Err(format!("[Linha {}, Coluna {}] Expressão inesperada: {:?}", line, col, other)),
        };

        while self.match_token(&[Token::LBrack]) {
            let index = self.parse_expression()?;
            self.consume(&Token::RBrack, "Esperado ']' após o índice.")?;
            expr = VirExpr::Index {
                target: Box::new(expr),
                index: Box::new(index),
            };
        }

        Ok(expr)
    }

    fn match_token(&mut self, types: &[Token]) -> bool {
        for t in types {
            if self.check(t) {
                self.advance();
                return true;
            }
        }
        false
    }

    fn check(&self, token: &Token) -> bool {
        if self.is_at_end() {
            false
        } else {
            &self.tokens[self.position].0 == token
        }
    }

    fn advance(&mut self) -> Token {
        if !self.is_at_end() {
            self.position += 1;
        }
        self.previous().clone()
    }

    fn previous(&self) -> Token {
        self.tokens[self.position - 1].0.clone()
    }

    fn is_at_end(&self) -> bool {
        matches!(self.tokens.get(self.position), Some((Token::Eof, _, _)) | None)
    }

    fn consume(&mut self, token: &Token, message: &str) -> Result<Token, String> {
        let (line, col) = (self.peek_line(), self.peek_col());
        if self.check(token) {
            Ok(self.advance())
        } else {
            Err(format!("[Linha {}, Coluna {}] {}", line, col, message))
        }
    }

    fn peek(&self) -> &Token {
        &self.tokens.get(self.position).unwrap_or(&(Token::Eof, 0, 0)).0
    }

    fn peek_line(&self) -> usize {
        self.tokens.get(self.position).map_or(0, |t| t.1)
    }

    fn peek_col(&self) -> usize {
        self.tokens.get(self.position).map_or(0, |t| t.2)
    }
}
