// Teste de Negação e Operadores Relacionais Avançados

seja bloqueado = falso;
seja nivel = 10;

se nao bloqueado e nivel >= 10 {
    imprimir "Acesso autorizado com sucesso!";
}

se nivel != 5 {
    imprimir "Nível é diferente de 5.";
}

se nivel <= 15 {
    imprimir "Nível está dentro do limite.";
}
