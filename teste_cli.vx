// Teste de funções no Vortex
fn soma(a, b) {
    return a + b;
}

fn fatorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * fatorial(n - 1);
}

let resultado_soma = soma(20, 22);
print(resultado_soma); // Deve imprimir 42

let resultado_fat = fatorial(5);
print(resultado_fat); // Deve imprimir 120
