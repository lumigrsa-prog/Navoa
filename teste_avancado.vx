// Teste Avançado: Funções, Vetores e Builtins em Vortex

funcao calcular_media(v, len) {
    seja total = v[0] + v[1] + v[2];
    retornar total / len;
}

imprimir "=== TESTE DE VETORES E FUNÇÕES ===";

seja notas = [12, 14, 16];

imprimir "Nota na posição 0:";
imprimir notas[0];

imprimir "Tamanho total do vetor:";
imprimir tamanho(notas);

imprimir "Calculando a média com função:";
seja media = calcular_media(notas, 3);
imprimir media;
